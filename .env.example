# ==============================================================================
# SEPMS (Software Engineering Portfolio Management System) Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# NOTE: Only values prefixed with VITE_ are exposed to the browser.
# NEVER put server secrets or database credentials in VITE_ variables!
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_API_BASE_URL=http://localhost:3001/api/v1

# ------------------------------------------------------------------------------
# Backend API Configuration (Express.js)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase Auth verification credentials for the server
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only Database Connection String (Direct or Transaction/Session Pooler from Supabase Connect)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres?sslmode=require

# Optional Admin Key (Used strictly for server-side user provisioning scripts)
# NEVER expose this key to the frontend or commit it to source control.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
