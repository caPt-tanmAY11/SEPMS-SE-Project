# ==============================================================================
# SEPMS (Software Engineering Portfolio Management System) Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# NOTE: Only variables prefixed with VITE_ are bundled into client code.
# NEVER put server secrets or database passwords in VITE_ variables!
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
VITE_API_BASE_URL=http://localhost:3001/api/v1

# ------------------------------------------------------------------------------
# Backend API Configuration (Express.js)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase Auth Verification Credentials for the Server
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Database Connection String
# IMPORTANT for Supabase: Use IPv4 Connection Pooler URI (Session Mode on port 5432 or Transaction Mode on 6543)
# To find it: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI -> Method: Session/Transaction
# Example format:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<your-project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: Supabase Service Role Key (Server-only for admin scripts like provision_demo_users)
# NEVER commit or expose to frontend client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
